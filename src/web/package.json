{
  "name": "gardenbuilder-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:scene": "dotnet run --project ../../tools/SchemaExport -- src/api/scene.schema.json && npm run gen:scene:ts",
    "gen:scene:ts": "json2ts -i src/api/scene.schema.json -o src/api/scene.generated.ts --bannerComment \"/* Generated from scene.schema.json by npm run gen:scene. Do not edit. */\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "json-schema-to-typescript": "^15.0.4",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
