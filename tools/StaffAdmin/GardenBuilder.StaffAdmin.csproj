<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Creates and manages staff accounts. Started from the Aspire dashboard's staff-admin commands, or from a terminal. -->
  <PropertyGroup>
    <RootNamespace>GardenBuilder.StaffAdmin</RootNamespace>
    <!-- dotnet run starts in the folder it was called from, so a relative secrets folder means what the caller expects. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ServiceDefaults\GardenBuilder.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\GardenBuilder.Modules.Identity.csproj" />
  </ItemGroup>
</Project>
